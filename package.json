{
  "name": "elternzeit-zielplaner",
  "version": "3.10.0",
  "private": true,
  "type": "module",
  "description": "Offline-Elternzeit- und Elterngeld-Zielplaner mit datierten Rechtsregeln und Szenariensuche",
  "scripts": {
    "test": "node scripts/run-checks.mjs && node --test tests/*.test.mjs",
    "check": "npm test",
    "rules:sync": "node scripts/embed-rules.mjs",
    "rules:check": "node scripts/embed-rules.mjs --check",
    "axes:sync": "node scripts/embed-time-axes.mjs",
    "axes:check": "node scripts/embed-time-axes.mjs --check",
    "modules:sync": "node scripts/embed-modules.mjs",
    "modules:check": "node scripts/embed-modules.mjs --check",
    "test:e2e": "playwright test",
    "references:report": "node scripts/reference-report.mjs",
    "release:check": "node scripts/release-check.mjs",
    "direct-file:proof:write": "node scripts/direct-file-proof.mjs --write",
    "direct-file:proof:check": "node scripts/direct-file-proof.mjs --check",
    "legislation:sync": "node scripts/embed-legislation.mjs",
    "legislation:check": "node scripts/embed-legislation.mjs --check",
    "historical:report": "node scripts/historical-report.mjs",
    "quickstart:sync": "node scripts/embed-quickstart.mjs",
    "quickstart:check": "node scripts/embed-quickstart.mjs --check",
    "sources:check": "node scripts/sources-check.mjs",
    "roadmap:check": "node scripts/roadmap-check.mjs",
    "docs:check": "node scripts/docs-status-check.mjs",
    "legacy:check": "node scripts/legacy-function-check.mjs",
    "maternity:check": "node scripts/maternity-delta-check.mjs",
    "independent-cases:check": "node scripts/independent-cases-check.mjs",
    "privacy:technical-check": "node scripts/privacy-technical-check.mjs",
    "search:micro-proof": "node scripts/search-micro-proof.mjs",
    "independent-evidence:check": "node scripts/independent-evidence-check.mjs",
    "usability:check": "node scripts/usability-check.mjs",
    "review:kit:check": "node scripts/review-kit-build.mjs --check",
    "review:kit:write": "node scripts/review-kit-build.mjs --write",
    "review:kit:verify": "node scripts/review-kit-build.mjs --verify",
    "staging:build": "node scripts/staging-build.mjs",
    "staging:check": "node scripts/staging-check.mjs",
    "staging:smoke": "node scripts/staging-smoke.mjs",
    "pages:build": "node scripts/pages-preview-build.mjs",
    "pages:check": "node --test tests/pages-preview.test.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.1",
    "jsdom": "^26.1.0"
  }
}
